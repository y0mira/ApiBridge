{
  "name": "api-bridge-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "tsup": {
      "esbuild": "^0.28.1"
    }
  },
  "engines": {
    "node": ">=20.17"
  },
  "scripts": {
    "dev": "vite",
    "preview:web": "vite preview",
    "build": "npm run build:core && npm run build:cli && npm run build:web",
    "build:web": "tsc -b && vite build",
    "build:core": "tsup --config packages/core/tsup.config.ts",
    "build:cli": "tsup --config packages/cli/tsup.config.ts",
    "build:launcher": "npm run build:web && node scripts/build-launcher.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false && tsc -p packages/cli/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:cli": "vitest run packages/cli",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pack:cli": "npm pack --workspace @api-bridge/cli",
    "pack:core": "npm pack --workspace @api-bridge/core",
    "benchmark": "npm run build:core && node scripts/benchmark.mjs",
    "pack:smoke": "npm run build:core && npm run build:cli && node scripts/pack-smoke.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-query": "^5.66.0",
    "dexie": "^4.0.11",
    "i18next": "^25.4.2",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.52.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.7.3",
    "react-router": "^7.1.3",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.4",
    "axios": "^1.19.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "fake-indexeddb": "^6.0.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "msw": "^2.7.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "tsup": "^8.5.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.0.5",
    "vitest": "^3.2.4"
  }
}
